#include "naive_softmax.cuh"
#include <hip/hip_runtime.h>
#include <cmath>

template<typename T>
__global__ void naive_softmax_kernel(
    const T* input,
    T* output,
    int rows,
    int cols
) {
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    
    if (idx < rows) {
        const T* row_input = input + idx * cols;
        T* row_output = output + idx * cols;
        
        // Find max for numerical stability
        T max_val = row_input[0];
        for (int i = 1; i < cols; i++) {
            max_val = max(max_val, row_input[i]);
        }
        
        // Compute exp and sum
        T sum = 0;
        for (int i = 0; i < cols; i++) {
            T exp_val = exp(row_input[i] - max_val);
            row_output[i] = exp_val;
            sum += exp_val;
        }
        
        // Normalize
        for (int i = 0; i < cols; i++) {
            row_output[i] /= sum;
        }
    }
}

void naive_softmax_forward(
    const float* input,
    float* output,
    int rows,
    int cols
) {
    int threads = 256;
    int blocks = (rows + threads - 1) / threads;
    
   hipLaunchKernelGGL(( naive_softmax_kernel), dim3(blocks), dim3(threads), 0, 0, 
        input, output, rows, cols
    );
    
    hipDeviceSynchronize();
}

template __global__ void naive_softmax_kernel<float>(
    const float*, float*, int, int
);
